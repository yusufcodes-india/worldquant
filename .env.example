# Alpha Research Pilot - Environment Configuration
# NEVER commit real credentials or keys to version control.

# Local Backend Binding (Loopback Only for Security)
PILOT_HOST=127.0.0.1
PILOT_PORT=8765

# Secure Pairing Token (High entropy hex string. If blank, automatically generated on startup)
PILOT_PAIRING_TOKEN=

# Database Path
PILOT_DB_PATH=pilot.db

# Google Gemini API Key (Can also be set securely via the Pilot UI / OS storage)
GEMINI_API_KEY=

# Default Gemini Model
GEMINI_MODEL=gemini-3.8-flash

# Platform Integration Mode: MOCK | MANUAL | LIVE
# LIVE requires explicit verified platform access and user approval
INTEGRATION_MODE=MOCK

# WorldQuant BRAIN Credentials (Only used in verified LIVE mode with explicit confirmation)
BRAIN_USERNAME=
BRAIN_PASSWORD=
BRAIN_BASE_URL=https://api.worldquantbrain.com

# Feature Flags
FEATURE_FLAG_TAB_OBSERVATION=false
